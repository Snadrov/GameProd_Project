--- !u!102 &804410953
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 804410951}
  m_Text: "The place is real.\nI can feel it pressing against my thoughts\neven when
    I close my eyes.\nMaps fail because it does not want to\nbe found, only reached.\nThe
    closer I get, the quieter everything else becomes,\nas if my fear, my doubts,\neven
    my need to return are being gently stripped away.\nIf I hesitate now, I know
    it will only grow louder.\nI must go while I am still able to tell myself\n this
    was my choice."
  m_OffsetZ: 0
  m_CharacterSize: 0.01
  m_LineSpacing: 1
  m_Anchor: 0
  m_Alignment: 0
  m_TabSize: 4
  m_FontSize: 0
  m_FontStyle: 0
  m_RichText: 1
  m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
